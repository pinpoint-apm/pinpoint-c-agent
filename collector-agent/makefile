
# DO NOT Change it by hand, it managed by CI(sync-component-versions)
TAG := v0.7.10

.PHONY: default
default: server ;

# Generates server/version_gen.go from the synchronized makefile version.
# DO NOT Change it by hand, it managed by CI(sync-component-versions)
version:
	@echo '// Code generated by make version. DO NOT EDIT.' > server/version_gen.go; \
	echo 'package server' >> server/version_gen.go; \
	echo '' >> server/version_gen.go; \
	echo "var Version = \"$(TAG)\" // synchronized version" >> server/version_gen.go

.PHONY: print-version
print-version:
	@echo $(TAG)

# Regenerates the Go protobuf code under pinpoint-grpc-idl-go/proto/v1 from the
# .proto files in the pinpoint-grpc-idl submodule. The generated *.pb.go files
# are NOT committed to the repo (see .gitignore) and are produced at build time.
#
# Required tool versions (project is go 1.26.0 / grpc v1.83.1):
#   protoc-gen-go      v1.33.0   (pinned; newer versions emit unsafe.StringData)
#   protoc-gen-go-grpc v1.3.0    (pinned; newer versions emit the generic streaming API)
# Install with:
#   go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.33.0
#   go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.3.0
protoc:
	mkdir -p pinpoint-grpc-idl-go/proto/v1
	protoc --go_out=pinpoint-grpc-idl-go/proto/ --go-grpc_out=pinpoint-grpc-idl-go/proto  --proto_path=pinpoint-grpc-idl/proto/ --go-grpc_opt=paths=source_relative v1/Annotation.proto v1/Cmd.proto v1/CustomMetric.proto v1/Service.proto v1/Span.proto v1/Stat.proto v1/ThreadDump.proto

server: protoc version
	go mod tidy
	# DO NOT Change it by hand, it managed by CI(sync-component-versions)
	# Version is generated into server/version_gen.go from TAG; do
	# not inject via -ldflags.
	go build .

clean:
	rm -rf pinpoint-grpc-idl/proto/v1/*.go
	rm -rf collector-agent

test: server
	go test ./... -v	

docker:
	docker build  -f Dockerfile -t collector-agent:${TAG}  .
