
# The version is defined once in versions.json (repo root) and generated into
# server/version_gen.go. Derive the docker tag from versions.json so it can
# never drift from the compiled-in version.
# NOTE: use sed (not `grep -oP`) so this works with BSD grep on macOS.
TAG ?= $(shell sed -n 's/.*"collector-agent": *"\([^"]*\)".*/\1/p' ../versions.json)

.PHONY: default
default: server ;

# Generates server/version_gen.go from the single source of truth
# (repo-root versions.json). The "v" prefix is added here because the client
# (pinpointPy C++ core HandleHelloMsg) compares Version lexicographically
# against lowest_version="v0.7.0"; without the prefix the handshake fails.
version:
	@V=$$(sed -n 's/.*"collector-agent": *"\([^"]*\)".*/\1/p' ../versions.json); \
	if [ -z "$$V" ]; then echo "error: collector-agent version not found in versions.json" >&2; exit 1; fi; \
	echo '// Code generated by make version. DO NOT EDIT.' > server/version_gen.go; \
	echo 'package server' >> server/version_gen.go; \
	echo '' >> server/version_gen.go; \
	echo "var Version = \"v$$V\" // from versions.json" >> server/version_gen.go

# Regenerates the Go protobuf code under pinpoint-grpc-idl-go/proto/v1 from the
# .proto files in the pinpoint-grpc-idl submodule. The generated *.pb.go files
# are NOT committed to the repo (see .gitignore) and are produced at build time.
#
# Required tool versions (must match the project's go 1.19 / grpc v1.56.3):
#   protoc-gen-go      v1.33.0   (newer versions emit unsafe.StringData, needs go1.20+)
#   protoc-gen-go-grpc v1.3.0    (newer versions emit generic streaming API, needs grpc v1.64+)
# Install with:
#   go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.33.0
#   go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.3.0
protoc:
	mkdir -p pinpoint-grpc-idl-go/proto/v1
	protoc --go_out=pinpoint-grpc-idl-go/proto/ --go-grpc_out=pinpoint-grpc-idl-go/proto  --proto_path=pinpoint-grpc-idl/proto/ --go-grpc_opt=paths=source_relative v1/Annotation.proto v1/Cmd.proto v1/CustomMetric.proto v1/Service.proto v1/Span.proto v1/Stat.proto v1/ThreadDump.proto

server: protoc version
	go mod tidy
	# Version is generated into server/version_gen.go from versions.json; do
	# not inject via -ldflags.
	go build .

clean:
	rm -rf pinpoint-grpc-idl/proto/v1/*.go
	rm -rf collector-agent

test: server
	go test ./... -v	

docker:
	docker build  -f Dockerfile -t collector-agent:${TAG}  . 